# Copie para .env (não versionar). Nada é obrigatório para rodar localmente.
PORT=4300
BASE_URL=http://localhost:4300
# Critério de entrada (a equipe informa os seguidores no admin e confirma o titular; dá para ajustar na tela)
MIN_FOLLOWERS=10000
# E-mail que vira administrador ao entrar pelo link mágico
ADMIN_EMAIL=
# Envio de e-mail do link de acesso (produção). Sem isso, em modo dev o link aparece na tela.
RESEND_API_KEY=
MAIL_FROM=
NODE_ENV=development
# Banco SQLite (padrão: data/mvp.sqlite)
DB_PATH=
# Conexão oficial (só depois que o app for aprovado pela plataforma; sem isso os botões avisam e deixam seguir)
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Login com Google (rota GET /api/auth/google ainda a implementar)
GOOGLE_CLIENT_ID=
